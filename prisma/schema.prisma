// Esquema de base de datos — Plataforma de Clases Particulares (MVP)
// Ver MVP-plataforma-clases-particulares.md, sección 4, para el modelo original.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum Modality {
  in_person
  online
  both
}

enum Level {
  primaria
  eso
  bachillerato
  universidad
  adultos
}

// Ámbito de nivel superior: la web ya no es solo educación — también
// entrenadores deportivos y profesionales de la salud mental.
enum Vertical {
  educacion
  deporte
  salud_mental
}

enum TeacherStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  active
  suspended
}

// Niveles de suscripción del profesor (visibilidad del anuncio)
enum TeacherPlan {
  free
  pro
  premium
}

enum BookingStatus {
  pending
  paid
  canceled
  refunded
}

enum EthicsReportStatus {
  open
  reviewed
  closed
}

enum StudentRequestStatus {
  open
  closed
}

// Curso concreto al que corresponde un material (más granular que Level)
enum MaterialCourse {
  eso_1
  eso_2
  eso_3
  eso_4
  bachillerato_1
  bachillerato_2
  universidad
  oposiciones
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  role          Role       @default(student)
  status        UserStatus @default(active)
  name          String
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  teacherProfile TeacherProfile?

  sentMessages         Message[]      @relation("MessageSender")
  studentConversations Conversation[] @relation("StudentConversations")
  teacherConversations Conversation[] @relation("TeacherConversations")
  bookings             Booking[]
  reviews              Review[]
  ethicsReports        EthicsReport[] @relation("EthicsReporter")
  studentRequests      StudentRequest[]

  @@map("users")
}

// Perfil de profesor (el "anuncio")
model TeacherProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  bio            String?
  pricePerHour   Decimal       @db.Decimal(10, 2)
  modality       Modality
  city           String?
  postalCode     String?
  experienceText String?
  status         TeacherStatus @default(pending)
  createdAt      DateTime      @default(now())

  // Suscripción (plan de visibilidad) — Stripe Billing
  plan                 TeacherPlan @default(free)
  stripeCustomerId     String?     @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus   String?

  // Cobro de la primera clase — Stripe Connect (cuenta del profesor)
  stripeConnectAccountId String? @unique
  stripeConnectOnboarded Boolean @default(false)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      TeacherSubject[]
  materials     Material[]
  bookings      Booking[]
  reviews       Review[]
  ethicsReports EthicsReport[]

  @@index([status])
  @@index([city])
  @@map("teacher_profiles")
}

// Valoración pública de un alumno sobre un profesor (solo tras una clase reservada y pagada)
model Review {
  id               String   @id @default(cuid())
  studentId        String
  teacherProfileId String
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  student        User           @relation(fields: [studentId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherProfileId])
  @@index([teacherProfileId])
  @@map("reviews")
}

// Canal ético: reportes privados de alumnos sobre la conducta de un profesor, solo visibles para el admin
model EthicsReport {
  id               String             @id @default(cuid())
  reporterId       String
  teacherProfileId String?
  message          String
  status           EthicsReportStatus @default(open)
  createdAt        DateTime           @default(now())

  reporter       User            @relation("EthicsReporter", fields: [reporterId], references: [id])
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)

  @@map("ethics_reports")
}

// Reserva de la primera clase pagada a través de la plataforma (comisión del 20%)
model Booking {
  id                      String        @id @default(cuid())
  studentId               String
  teacherProfileId        String
  amount                  Decimal       @db.Decimal(10, 2)
  platformFeeAmount       Decimal       @db.Decimal(10, 2)
  status                  BookingStatus @default(pending)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  createdAt               DateTime      @default(now())

  student        User           @relation(fields: [studentId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([studentId, teacherProfileId])
  @@map("bookings")
}

// Categorías de nivel superior que estructuran la web: Ciencias, Humanidades,
// Oposiciones, Cursos oficiales (idiomas). Cada Subject pertenece a una.
model Subject {
  id       String   @id @default(cuid())
  name     String   @unique
  category String
  vertical Vertical @default(educacion)

  teacherSubjects TeacherSubject[]
  materials       Material[]
  studentRequests StudentRequest[]

  @@index([category])
  @@index([vertical])
  @@map("subjects")
}

// Anuncio publicado por un alumno pidiendo profesor: el flujo inverso al
// perfil de profesor. Los profesores lo consultan desde su panel; solo los
// planes Pro/Premium pueden contactar (ver TeacherPlan).
model StudentRequest {
  id            String               @id @default(cuid())
  studentId     String
  subjectId     String
  title         String
  description   String
  level         Level
  modality      Modality
  city          String?
  budgetPerHour Decimal?             @db.Decimal(10, 2)
  status        StudentRequestStatus @default(open)
  createdAt     DateTime             @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subjectId])
  @@map("student_requests")
}

// Material didáctico que un profesor deja disponible para descarga, asociado a una materia
model Material {
  id               String         @id @default(cuid())
  title            String
  description      String?
  subjectId        String
  teacherProfileId String
  course           MaterialCourse
  fileUrl          String
  fileName         String
  createdAt        DateTime       @default(now())

  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([course])
  @@map("materials")
}

// Tabla puente: un profesor puede impartir varias materias a distintos niveles
// El nivel educativo solo aplica al ámbito "educacion" — un entrenador
// deportivo o un psicólogo no tienen "ESO" o "Bachillerato", así que es
// opcional y ya no puede formar parte de la clave primaria compuesta.
model TeacherSubject {
  id               String @id @default(cuid())
  teacherProfileId String
  subjectId        String
  level            Level?

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, subjectId, level])
  @@map("teacher_subjects")
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  createdAt DateTime @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  teacher  User      @relation("TeacherConversations", fields: [teacherId], references: [id])
  messages Message[]

  @@unique([studentId, teacherId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@map("messages")
}

// --- Auth.js (NextAuth) — adapter de Prisma + recuperación de contraseña ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
