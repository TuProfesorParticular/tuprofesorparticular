// Esquema de base de datos — Plataforma de Clases Particulares (MVP)
// Ver MVP-plataforma-clases-particulares.md, sección 4, para el modelo original.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum Modality {
  in_person
  online
  both
}

enum Level {
  infantil
  primaria
  eso
  bachillerato
  universidad
  adultos
}

// Ámbito de nivel superior: la web ya no es solo educación — también
// entrenadores deportivos y profesionales de la salud mental.
enum Vertical {
  educacion
  deporte
  salud_mental
}

enum TeacherStatus {
  pending
  approved
  rejected
}

enum MaterialStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  active
  suspended
}

// Niveles de suscripción del profesor (visibilidad del anuncio)
enum TeacherPlan {
  free
  pro
  premium
}

enum BookingStatus {
  pending
  paid
  canceled
  refunded
}

enum EthicsReportStatus {
  open
  reviewed
  closed
}

enum StudentRequestStatus {
  open
  closed
}

// Curso concreto al que corresponde un material (más granular que Level)
enum MaterialCourse {
  // "infantil" y "primaria" quedan obsoletos (no se ofrecen ya al subir un
  // material) pero se mantienen en el enum por los materiales ya guardados
  // con ese valor — ver infantil_1..3 y primaria_1..6 más abajo.
  infantil
  primaria
  eso_1
  eso_2
  eso_3
  eso_4
  bachillerato_1
  bachillerato_2
  universidad
  oposiciones
  // Niveles del Marco Común Europeo de Referencia (MCER/CEFR), comunes a
  // todas las certificaciones oficiales de idiomas (Cambridge, EOI, DELF/
  // DALF, Goethe-Institut, CELI...) — para la categoría "Cursos oficiales".
  a1
  a2
  b1
  b2
  c1
  c2
  // Segundo ciclo de Educación Infantil (LOMLOE), 3-6 años.
  infantil_1
  infantil_2
  infantil_3
  // Educación Primaria (LOMLOE), 6 cursos.
  primaria_1
  primaria_2
  primaria_3
  primaria_4
  primaria_5
  primaria_6
  // Nivel de progresión, para las categorías de Deporte (Deportes de
  // Combate, Raqueta, Equipo, Entrenamiento Personal, Yoga, Fitness y
  // Bienestar Físico) — el equivalente a un "curso" cuando no hay niveles
  // académicos.
  principiante
  intermedio
  avanzado
  // Tipo de recurso, para las categorías de Salud Mental (Psicología
  // Clínica, Terapia de Pareja/Familiar, TCC, Coaching, Mindfulness,
  // Psicopedagogía...).
  guias_pacientes
  casos_protocolos
  tests_evaluacion
  // Transversal a las tres ramas (Educación, Deporte, Salud Mental) y a
  // todas sus categorías: programaciones didácticas, planes de
  // entrenamiento o programas de intervención — se añade siempre junto al
  // resto de cursos/niveles de cada categoría, no sustituye a ninguno.
  programaciones
}

// Las 17 comunidades autónomas, para el envío de CV a colegios por zona
enum SpanishRegion {
  madrid
  andalucia
  cataluna
  valencia
  murcia
  canarias
  castilla_la_mancha
  castilla_y_leon
  galicia
  aragon
  extremadura
  pais_vasco
  asturias
  cantabria
  navarra
  la_rioja
  baleares
}

enum CvCampaignStatus {
  pending // creada, esperando el pago
  paid // pagada, pendiente de enviar los emails
  sent // emails enviados a los colegios de la zona
  failed // el pago se completó pero el envío falló (revisar en admin)
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  role          Role       @default(student)
  status        UserStatus @default(active)
  name          String
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())

  // Programa de referidos: quién invitó a este usuario a registrarse (link
  // /registro?ref=<id del que invita>). Solo se usa entre profesores, para
  // recompensar a quien trae a otro profesional a la plataforma (ver
  // referralRewardGranted en TeacherProfile y setTeacherProfileStatus).
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("Referrals")

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  teacherProfile TeacherProfile?

  sentMessages         Message[]      @relation("MessageSender")
  studentConversations Conversation[] @relation("StudentConversations")
  teacherConversations Conversation[] @relation("TeacherConversations")
  bookings             Booking[]
  reviews              Review[]
  ethicsReports        EthicsReport[] @relation("EthicsReporter")
  studentRequests      StudentRequest[]
  cvCampaigns          CvCampaign[]
  suggestions          Suggestion[]   @relation("SuggestionAuthor")

  @@map("users")
}

// Perfil de profesor (el "anuncio")
model TeacherProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  bio            String?
  pricePerHour   Decimal       @db.Decimal(10, 2)
  modality       Modality
  city           String?
  postalCode     String?
  experienceText String?
  // Nº de colegiado profesional — se muestra en el anuncio público para dar
  // confianza, principalmente en la vertical Salud Mental (psicólogos,
  // logopedas...), aunque no está restringido a nivel de base de datos.
  licenseNumber  String?
  status         TeacherStatus @default(pending)
  createdAt      DateTime      @default(now())

  // Ámbito profesional declarado al registrarse (Educación / Deporte / Salud
  // Mental) — se usa sobre todo para repartir el cupo de "100 fundadores"
  // por separado en cada ámbito, en vez de un único cupo global de 100.
  vertical Vertical @default(educacion)

  // Suscripción (plan de visibilidad) — Stripe Billing
  plan                 TeacherPlan @default(free)
  stripeCustomerId     String?     @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus   String?

  // Programa "profesor fundador" (los 100 primeros DE CADA ámbito —
  // Educación, Deporte y Salud Mental, por separado): 3 meses de Pro gratis
  // y después precio de fundador fijo para siempre (ver FOUNDER_PRICES).
  isFounder          Boolean   @default(false)
  founderProUntil    DateTime?
  founderLockedPrice Decimal?  @db.Decimal(10, 2)

  // Programa de referidos: si este profesor invitó a otro y ese otro fue
  // aprobado, se le regalan 30 días de Pro gratis (reutilizando el mismo
  // mecanismo de founderProUntil que el programa de fundadores, ver
  // isInFounderFreeTrial). Este flag va en el perfil del profesor
  // RECOMENDADO (no en el que invita), para no volver a dar la recompensa si
  // el admin despublica y vuelve a publicar su anuncio más tarde.
  referralRewardGranted Boolean @default(false)

  // Resumen semanal por email (visitas, mensajes, valoraciones — ver
  // /api/cron/weekly-digest). Desactivable desde "Mi cuenta".
  weeklyDigestOptOut Boolean @default(false)

  // Cobro de la primera clase — Stripe Connect (cuenta del profesor)
  stripeConnectAccountId String? @unique
  stripeConnectOnboarded Boolean @default(false)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects      TeacherSubject[]
  materials     Material[]
  bookings      Booking[]
  reviews       Review[]
  ethicsReports EthicsReport[]
  availability  AvailabilitySlot[]

  @@index([status])
  @@index([city])
  @@map("teacher_profiles")
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// Disponibilidad semanal recurrente del profesor/profesional: no es un
// calendario de reservas reales, solo indica en qué días y horas suele
// dar clase, para que el alumno sepa cuándo contactarle.
model AvailabilitySlot {
  id               String  @id @default(cuid())
  teacherProfileId String
  weekday          Weekday
  hour             Int // hora de inicio del tramo, 0-23 (ej. 17 = 17:00-18:00)

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, weekday, hour])
  @@map("availability_slots")
}

// Valoración pública de un alumno sobre un profesor (solo tras una clase reservada y pagada)
model Review {
  id               String   @id @default(cuid())
  studentId        String
  teacherProfileId String
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  student        User           @relation(fields: [studentId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherProfileId])
  @@index([teacherProfileId])
  @@map("reviews")
}

// Canal ético: reportes privados de alumnos sobre la conducta de un profesor, solo visibles para el admin
model EthicsReport {
  id               String             @id @default(cuid())
  reporterId       String
  teacherProfileId String?
  message          String
  status           EthicsReportStatus @default(open)
  createdAt        DateTime           @default(now())

  reporter       User            @relation("EthicsReporter", fields: [reporterId], references: [id])
  teacherProfile TeacherProfile? @relation(fields: [teacherProfileId], references: [id], onDelete: SetNull)

  @@map("ethics_reports")
}

enum SuggestionCategory {
  error
  mejora
  otro
}

// Apartado "Sugerencias" del panel (alumnos y profesores): errores o
// propuestas de mejora que llegan directamente al administrador — se
// guardan aquí y además se avisa por email (ver sendNewSuggestionEmail).
model Suggestion {
  id        String             @id @default(cuid())
  userId    String
  category  SuggestionCategory @default(otro)
  message   String
  status    EthicsReportStatus @default(open)
  createdAt DateTime           @default(now())

  user User @relation("SuggestionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("suggestions")
}

// Reserva de la primera clase pagada a través de la plataforma (comisión del 20%)
model Booking {
  id                      String        @id @default(cuid())
  studentId               String
  teacherProfileId        String
  amount                  Decimal       @db.Decimal(10, 2)
  platformFeeAmount       Decimal       @db.Decimal(10, 2)
  status                  BookingStatus @default(pending)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  createdAt               DateTime      @default(now())
  refundRequestedAt       DateTime?
  refundReason            String?

  student        User           @relation(fields: [studentId], references: [id])
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id])

  @@unique([studentId, teacherProfileId])
  @@map("bookings")
}

// Categorías de nivel superior que estructuran la web: Ciencias, Humanidades,
// Oposiciones, Cursos oficiales (idiomas). Cada Subject pertenece a una.
model Subject {
  id       String   @id @default(cuid())
  name     String   @unique
  category String
  vertical Vertical @default(educacion)

  teacherSubjects TeacherSubject[]
  materials       Material[]
  studentRequests StudentRequest[]

  @@index([category])
  @@index([vertical])
  @@map("subjects")
}

// Anuncio publicado por un alumno pidiendo profesor: el flujo inverso al
// perfil de profesor. Los profesores lo consultan desde su panel; solo los
// planes Pro/Premium pueden contactar (ver TeacherPlan).
model StudentRequest {
  id            String               @id @default(cuid())
  studentId     String
  subjectId     String
  title         String
  description   String
  level         Level
  modality      Modality
  city          String?
  budgetPerHour Decimal?             @db.Decimal(10, 2)
  status        StudentRequestStatus @default(open)
  createdAt     DateTime             @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subjectId])
  @@map("student_requests")
}

// Material didáctico que un profesor deja disponible para descarga, asociado a una materia
model Material {
  id               String         @id @default(cuid())
  title            String
  description      String?
  subjectId        String
  teacherProfileId String
  course           MaterialCourse
  fileUrl          String
  fileName         String
  // Pendiente hasta que un admin lo revisa: solo se ve en la web y cuenta
  // para el descuento por materiales una vez aprobado.
  status           MaterialStatus @default(pending)
  createdAt        DateTime       @default(now())

  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([course])
  @@index([status])
  @@map("materials")
}

// Tabla puente: un profesor puede impartir varias materias a distintos niveles
// El nivel educativo solo aplica al ámbito "educacion" — un entrenador
// deportivo o un psicólogo no tienen "ESO" o "Bachillerato", así que es
// opcional y ya no puede formar parte de la clave primaria compuesta.
model TeacherSubject {
  id               String @id @default(cuid())
  teacherProfileId String
  subjectId        String
  level            Level?

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherProfileId, subjectId, level])
  @@map("teacher_subjects")
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  createdAt DateTime @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  teacher  User      @relation("TeacherConversations", fields: [teacherId], references: [id])
  messages Message[]

  @@unique([studentId, teacherId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@map("messages")
}

// --- Auth.js (NextAuth) — adapter de Prisma + recuperación de contraseña ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// Analítica propia, de primera parte y anónima (sin cookies, id aleatorio en
// localStorage del navegador) para el panel de administración: visitas,
// visitantes únicos y tiempo en página. No se comparte con terceros.
model PageView {
  id         String   @id @default(cuid())
  path       String
  visitorId  String
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([visitorId])
  @@map("page_views")
}

// Monitorización de errores propia (en vez de un servicio externo tipo
// Sentry): captura errores no controlados del servidor vía
// instrumentation.ts (onRequestError) para poder verlos en /admin/errores
// sin depender de que un usuario los reporte.
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("error_logs")
}

// Contacto de un colegio/instituto privado o concertado al que se le puede
// enviar el CV de un profesor. Se rellena poco a poco desde /admin/colegios,
// comunidad a comunidad, antes de habilitar el envío de pago para esa zona.
// Centro al que se puede enviar un CV: colegio (Educación), gimnasio/club
// (Deporte) o clínica/gabinete (Salud Mental) — un mismo modelo para las
// tres verticales, distinguidas por el campo `vertical`.
model InstitutionContact {
  id           String        @id @default(cuid())
  vertical     Vertical      @default(educacion)
  name         String
  region       SpanishRegion
  email        String
  province     String?
  // Tipo de centro (Privado/Concertado, Gimnasio/Club, Clínica/Gabinete...),
  // informativo, sin restricción
  type         String?
  // Si está desactivado o se ha dado de baja, se excluye de los envíos
  // aunque siga en la base de datos (para no perder el registro).
  active       Boolean       @default(true)
  unsubscribed Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([vertical, region, active, unsubscribed])
  @@map("institution_contacts")
}

// Compra de un profesional para que enviemos su CV a los centros de una
// comunidad (o a toda España): colegios, gimnasios/clubes o clínicas/
// gabinetes, según el ámbito (`vertical`) del profesional. Un pago único vía
// Stripe Checkout; el pago solo da acceso — el profesional sube el CV y
// confirma el envío después, desde /tu-cv/envios/[id] (ver
// dispatchCvCampaign en src/lib/cv-campaigns.ts).
model CvCampaign {
  id     String @id @default(cuid())
  userId String

  // Ámbito del profesional en el momento de comprar (educación → colegios,
  // deporte → gimnasios/clubes, salud_mental → clínicas/gabinetes).
  vertical Vertical @default(educacion)

  // Null cuando nationwide = true (cubre todas las comunidades)
  region     SpanishRegion?
  nationwide Boolean        @default(false)
  // Provincias elegidas dentro de la comunidad (el precio es el mismo,
  // pagar la comunidad da derecho a elegir cualquier subconjunto de sus
  // provincias). Array vacío = todas las provincias de la comunidad. Cada
  // valor debe coincidir con InstitutionContact.province para esa región.
  provinces  String[]       @default([])
  // Centros concretos que el profesional ha quitado a mano de la lista
  // antes de confirmar el envío (aunque su provincia esté incluida).
  excludedContactIds String[] @default([])

  amount Decimal @db.Decimal(10, 2)

  // Nulos hasta que el profesor los rellena tras el pago, en el paso de
  // confirmación (/tu-cv/envios/[id]).
  cvFileUrl  String?
  cvFileName String?
  // Mensaje/carta de presentación opcional que se incluye en el email
  message    String?

  // Carta de recomendación opcional (PDF/Word) y referencias en texto que
  // el profesional añade en el paso de confirmación, junto con el CV. Se
  // incluyen en el mismo correo que reciben los centros.
  recommendationFileUrl  String?
  recommendationFileName String?
  referencesText         String?

  status                  CvCampaignStatus @default(pending)
  stripeCheckoutSessionId String?          @unique

  sentCount   Int @default(0)
  failedCount Int @default(0)

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("cv_campaigns")
}

// Titulares importados de medios externos (ver /api/cron/fetch-news y
// NEWS_SOURCES) para la sección "Noticias" — cada uno enlaza al artículo
// original, nunca reproducimos el contenido completo de otro medio.
model NewsItem {
  id          String   @id @default(cuid())
  vertical    Vertical
  sourceName  String
  title       String
  link        String   @unique
  summary     String?
  imageUrl    String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([vertical, publishedAt])
  @@map("news_items")
}
